# ===== 服务 =====
PORT=3000
# 数据库文件路径（默认 data/xjhack.db）
DB_PATH=data/xjhack.db

# ===== 邮件验证码 =====
# dev：验证码打印到服务器控制台，接口响应附带 devCode（仅本地测试用）
# resend：走 Resend API（https://resend.com，月 3000 封免费）
# smtp：走 SMTP（阿里云邮件推送 / 腾讯云 SES / 任意 SMTP）
MAIL_MODE=dev
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="学军黑客松 <noreply@example.com>"

# ===== 微信扫码登录（未配置时前端显示"暂未启用"） =====
# 需微信开放平台"网站应用"：企业/个体户主体 + 开发者资质认证(300元/年) + 已备案域名
# 申请地址：https://open.weixin.qq.com -> 网站应用
WECHAT_APPID=
WECHAT_APPSECRET=
# 回调地址必须与开放平台后台配置的授权域名完全一致，且已 ICP 备案
# 例如：https://xjhack.example.com/api/auth/wechat/callback
WECHAT_REDIRECT_URI=

# ===== 管理员（邮箱逗号分隔，登录后自动获得管理员权限） =====
ADMIN_EMAILS=admin@xjhack.local

# ===== 数据库双模式 =====
# 留空（默认）→ SQLite 本地文件（data/xjhack.db，开发/局域网演示用）
# 设置 → PostgreSQL（扣子/火山引擎部署时由平台注入连接串，自动启用 PG 模式）
DATABASE_URL=

# ===== 联系方式加密（生产强烈建议） =====
# 64 位 hex（32 字节）。生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未配置时联系方式明文存储（仅开发/演示）
ENC_KEY=
